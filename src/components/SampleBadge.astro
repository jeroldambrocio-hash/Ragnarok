---
/** Marks data that is illustrative until the real API is connected. */
const { label = "Datos de ejemplo" } = Astro.props as { label?: string };
---
<span class="sample-badge" title="Estos datos son de ejemplo hasta conectar el servidor real.">{label}</span>
<style>
  .sample-badge {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.2rem 0.55rem;
    font: 500 0.75rem/1.3 var(--sans);
    letter-spacing: 0.04em;
    color: var(--text-2);
    border: 1px dashed var(--line-strong);
    border-radius: 999px;
    white-space: nowrap;
  }
</style>
