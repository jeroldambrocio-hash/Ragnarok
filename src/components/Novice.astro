---
/**
 * Novice: an animated guide that doubles as a navigation link.
 *
 * PLACEHOLDER ART: the character below is an authored SVG stand-in, not an
 * official Ragnarok Online sprite. To use a real sprite later, pass `sprite`
 * (path to a PNG/WebP in /public) and it replaces the SVG; the link, label,
 * hover, cursor-look (head tilt) and click behaviour all keep working.
 */
import Icon from "./Icon.astro";
interface Props {
  href: string;
  label: string;
  icon: string;
  hair?: string;
  delay?: number;
  facing?: "left" | "right";
  sprite?: string;
}
const { href, label, icon, hair = "#6b3f22", delay = 0, facing = "right", sprite } = Astro.props;
const flip = facing === "left";
---
<a class="novice" href={href} data-novice style={`--hair:${hair};--d:${delay}s`}>
  <span class="novice-label"><Icon name={icon} size={16} />{label}</span>
  <span class="novice-fig" aria-hidden="true">
    {sprite ? (
      <img class="novice-sprite" src={sprite} alt="" width="80" height="110" loading="lazy" decoding="async" />
    ) : (
      <svg viewBox="0 0 80 110" width="80" height="110" class:list={["novice-svg", { "is-flipped": flip }]}>
        <ellipse class="nv-glow" cx="40" cy="104" rx="26" ry="6" />
        <ellipse class="nv-shadow" cx="40" cy="104" rx="17" ry="3.6" />
        <g class="nv-body">
          <rect x="31" y="83" width="8" height="17" rx="3" fill="#5a3d2a" />
          <rect x="41" y="83" width="8" height="17" rx="3" fill="#5a3d2a" />
          <ellipse cx="34.5" cy="101" rx="5.5" ry="2.8" fill="#2b1f18" />
          <ellipse cx="45.5" cy="101" rx="5.5" ry="2.8" fill="#2b1f18" />
          <path d="M27 66c0-4 3-7 7-7h12c4 0 7 3 7 7v19H27z" fill="#e8dcc4" />
          <path d="M34 59l6 6 6-6" fill="none" stroke="#c9b894" stroke-width="1.6" stroke-linejoin="round" />
          <rect x="27" y="79" width="26" height="4.5" fill="#7a4e2d" />
          <rect x="38" y="79.4" width="4" height="3.7" rx="0.6" fill="#d4b06a" />
          <g class="nv-arm nv-arm-l"><rect x="20" y="61" width="7.5" height="18" rx="3.6" fill="#e8dcc4" /><circle cx="23.7" cy="80" r="3.4" fill="#f0cba8" /></g>
          <g class="nv-arm nv-arm-r"><rect x="52.5" y="61" width="7.5" height="18" rx="3.6" fill="#e8dcc4" /><circle cx="56.3" cy="80" r="3.4" fill="#f0cba8" /></g>
        </g>
        <g class="nv-head">
          <g class="nv-sway">
            <ellipse cx="40" cy="41" rx="20" ry="19" fill="#f2d0ae" />
            <ellipse cx="29.5" cy="49" rx="3.2" ry="1.9" fill="#e9a58d" opacity=".55" />
            <ellipse cx="50.5" cy="49" rx="3.2" ry="1.9" fill="#e9a58d" opacity=".55" />
            <g class="nv-eyes">
              <g class="nv-blink">
                <ellipse cx="33" cy="44" rx="2.7" ry="3.6" fill="#2a1c15" />
                <ellipse cx="47" cy="44" rx="2.7" ry="3.6" fill="#2a1c15" />
                <circle cx="33.9" cy="42.6" r="0.95" fill="#fff" />
                <circle cx="47.9" cy="42.6" r="0.95" fill="#fff" />
              </g>
            </g>
            <path class="nv-mouth" d="M37.6 51.5q2.4 1.8 4.8 0" fill="none" stroke="#9a5a45" stroke-width="1.3" stroke-linecap="round" />
            <path class="nv-hair" d="M19.5 47C17 33 22 24 30 20.5l-2.5-5.5 7.5 3.5 2-8 5 7.5 5-6.5 1 7.5 7-2.5-2.5 6.5C59 27 62.5 36 60.5 47c-3-7.5-7-11.5-12-13.5l-3 4-3.4-4.6-4.6 4-3-4.6C28.5 34 23.5 39 19.5 47z" fill="var(--hair)" />
          </g>
        </g>
      </svg>
    )}
  </span>
</a>

<style is:global>
  .novice {
    --lx: 0; --ly: 0; --tilt: 0;
    position: relative;
    display: inline-flex; flex-direction: column; align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.5rem 0;
    color: var(--text);
    text-decoration: none;
    border-radius: 12px;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .novice-fig { display: block; width: var(--nv-w, 92px); height: calc(var(--nv-w, 92px) * 1.375); }
  .novice-svg, .novice-sprite { width: 100%; height: 100%; overflow: visible; }
  .novice-svg.is-flipped { transform: scaleX(-1); }

  .novice-label {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    font: 600 0.8125rem/1 var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text);
    background: rgba(16, 18, 23, 0.82);
    border: 1px solid var(--line);
    border-radius: 999px;
    opacity: 0.72;
    transform: translateY(3px);
    transition: opacity var(--fast), transform 220ms var(--ease-out), border-color var(--fast);
    pointer-events: none;
  }
  .novice-label svg { color: var(--gold); }

  .nv-shadow { fill: rgba(0, 0, 0, 0.55); }
  .nv-glow { fill: var(--gold); opacity: 0; transition: opacity 220ms; filter: blur(6px); }

  .nv-body { transform-origin: 40px 100px; animation: nv-breathe 3.8s ease-in-out var(--d) infinite; }
  .nv-head { transform-origin: 40px 60px; transform: rotate(calc(var(--tilt) * 1deg)); transition: transform 180ms var(--ease-out); }
  .nv-sway { transform-origin: 40px 60px; animation: nv-sway 6s ease-in-out var(--d) infinite; }
  .nv-eyes { transform: translate(calc(var(--lx) * 1px), calc(var(--ly) * 1px)); transition: transform 120ms linear; }
  .nv-blink { transform-origin: 40px 44px; animation: nv-blink 5.5s linear calc(var(--d) * 2) infinite; }
  .nv-arm { transition: transform 260ms var(--ease-out); }
  .nv-arm-l { transform-origin: 23.7px 63px; }
  .nv-arm-r { transform-origin: 56.3px 63px; }

  @media (hover: hover) {
    .novice:hover .novice-fig { animation: nv-hop 480ms var(--ease-out); }
    .novice:hover .nv-glow { opacity: 0.35; }
    .novice:hover .nv-arm-r { transform: rotate(-28deg); }
    .novice:hover .novice-label { opacity: 1; transform: none; border-color: rgba(212, 176, 106, 0.45); }
  }
  .novice:focus-visible .novice-label { opacity: 1; transform: none; border-color: var(--gold); }
  .novice:focus-visible { outline-offset: 2px; }

  .novice.is-go .novice-fig { animation: nv-go 420ms var(--ease-out) forwards; }
  .novice.is-go .nv-arm-r { transform: rotate(-150deg); }
  .novice.is-go .nv-arm-l { transform: rotate(40deg); }
  .novice.is-go .nv-glow { opacity: 0.55; }

  @keyframes nv-breathe { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(1.018); } }
  @keyframes nv-sway { 0%, 100% { transform: rotate(-1.2deg); } 50% { transform: rotate(1.2deg); } }
  @keyframes nv-blink { 0%, 95%, 100% { transform: scaleY(1); } 97% { transform: scaleY(0.1); } }
  @keyframes nv-hop {
    0% { transform: translateY(0) scale(1, 1); }
    18% { transform: translateY(0) scale(1.05, 0.95); }
    48% { transform: translateY(-10px) scale(0.97, 1.03); }
    80% { transform: translateY(0) scale(1.03, 0.97); }
    100% { transform: translateY(0) scale(1); }
  }
  @keyframes nv-go {
    0% { transform: translateY(0) scale(1); }
    30% { transform: translateY(2px) scale(1.06, 0.92); }
    65% { transform: translateY(-20px) scale(0.96, 1.05); }
    100% { transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nv-body, .nv-sway, .nv-blink { animation: none; }
    .novice:hover .novice-fig, .novice.is-go .novice-fig { animation: none; }
  }
</style>
