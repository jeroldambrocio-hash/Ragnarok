---
/**
 * War of Emperium night siege behind the hero.
 *
 * Original pixel art generated by tools/scene.py
 * (480x270 layers, shown at whole-pixel scale with pixelated rendering).
 * Each layer is its own plane with a parallax depth; regenerate them with
 * `python3 tools/scene.py`, or swap a PNG for new art of the same size.
 */
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/scene`;
const layers = [
  { src: "sky.png", depth: 0.08 },
  { src: "far.png", depth: 0.2 },
  { src: "castle.png", depth: 0.4 },
  { src: "mid.png", depth: 0.7 },
];
---
<div class="scene" aria-hidden="true" style={`--ground:url(${base}/ground.png)`}>
  <div class="scene-layers">
    {layers.map((l, i) => (
      <img class="layer" data-depth={l.depth} src={`${base}/${l.src}`} width="480" height="270" alt=""
        decoding="async" fetchpriority={i < 3 ? "high" : "auto"} />
    ))}
  </div>
  <canvas class="scene-embers" data-embers></canvas>
  <div class="scene-shade"></div>
  <div class="scene-ground"></div>
</div>

<script>
  import "../scripts/scene.ts";
</script>

<style>
  .scene { position: absolute; inset: 0; overflow: hidden; z-index: 0; background: #07080f; }
  .scene-layers {
    position: absolute; top: 0; bottom: 0; right: 0;
    width: max(100%, calc(100svh * 1.78));
  }
  .layer {
    position: absolute; inset: -2% -1% 0 -1%;
    width: 102%; height: 102%;
    max-width: none;
    object-fit: cover; object-position: 100% 100%;
    image-rendering: pixelated;
    will-change: transform;
  }
  .scene-embers { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .scene-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(11, 12, 15, 0.9) 0%, rgba(11, 12, 15, 0.62) 32%, rgba(11, 12, 15, 0.1) 58%, rgba(11, 12, 15, 0) 72%),
      linear-gradient(180deg, rgba(11, 12, 15, 0.5) 0%, rgba(11, 12, 15, 0) 18%, rgba(11, 12, 15, 0) 76%, rgba(11, 12, 15, 0.55) 100%);
  }
  .scene-ground {
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 96px;
    background: var(--ground) repeat-x left bottom / 480px 96px;
    image-rendering: pixelated;
  }

  /* Portrait: the castle takes the top band, the title sits clear below it. */
  @media (max-width: 760px), (max-aspect-ratio: 1/1) {
    .scene-layers {
      bottom: auto; height: 48%;
      width: max(100%, calc(48svh * 1.78));
      -webkit-mask-image: linear-gradient(180deg, #000 80%, transparent);
      mask-image: linear-gradient(180deg, #000 80%, transparent);
    }
    .scene-shade {
      background: linear-gradient(180deg, rgba(11, 12, 15, 0.4) 0%, rgba(11, 12, 15, 0) 14%, rgba(11, 12, 15, 0) 36%, rgba(11, 12, 15, 0.75) 52%, rgba(11, 12, 15, 0.9) 100%);
    }
    .scene-ground { height: 64px; background-size: 320px 64px; }
  }
</style>
