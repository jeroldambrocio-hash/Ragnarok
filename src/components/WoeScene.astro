---
/**
 * War of Emperium night scene for the hero.
 *
 * PLACEHOLDER ART: authored, layered SVG stand-in for real key art. Each layer
 * is a separate plane with a parallax depth; to use real art later, replace a
 * layer's <svg> with an <img> (WebP/AVIF) of the same aspect and keep the
 * data-depth attribute.
 */
// Deterministic jitter so the build is stable.
const rnd = (n: number) => {
  const v = Math.sin(n * 12.9898) * 43758.5453;
  return v - Math.floor(v);
};
// Siege column along the road, from the lower left up to the gate.
const road = (t: number) => ({
  x: 560 + t * 660 + Math.sin(t * 9) * 26,
  y: 812 - t * 248 - Math.sin(t * 3.1) * 18,
});
// Torches march in war-bands, not an even dotted line: each band is a clump
// of varied size and brightness, closer and bigger near the front.
const bands = [
  { t: 0.06, n: 7, spread: 0.07 },
  { t: 0.34, n: 6, spread: 0.06 },
  { t: 0.6, n: 5, spread: 0.05 },
  { t: 0.86, n: 8, spread: 0.06 },
];
const torches = bands.flatMap((b, bi) =>
  Array.from({ length: b.n }, (_, i) => {
    const k = bi * 10 + i + 1;
    const p = road(b.t + (rnd(k) - 0.5) * b.spread * 2);
    const near = 1 - b.t * 0.45;
    return {
      x: Math.round(p.x + (rnd(k + 50) - 0.5) * 22),
      y: Math.round(p.y + (rnd(k + 90) - 0.5) * 16),
      r: +((7 + rnd(k + 130) * 9) * near).toFixed(1),
      c: +((1.4 + rnd(k + 170) * 1.6) * near).toFixed(1),
      o: +(0.5 + rnd(k + 210) * 0.45).toFixed(2),
      d: (rnd(k + 250) * 1.6).toFixed(2),
    };
  }),
);
// Three flame silhouettes, mirrored and tilted so no two fires read alike.
const flameShapes = [
  "M0 0c-7-4-9-12-4-20 1 5 4 6 5 2 1-6-2-10 2-16 2 7 9 12 8 22-1 8-5 12-11 12z",
  "M0 0c-5-3-6-9-3-15 1 3 3 3 3 0 0-5 1-9 4-12 1 6 6 10 5 17-1 6-4 10-9 10z",
  "M0 0c-8-3-11-10-7-17 2 3 4 3 4-1 0-7 3-13 8-17-1 7 5 12 6 20 1 9-4 15-11 15z",
];
// Flames licking the wall top and the breached gate.
const flames = [
  { x: 1096, y: 470, s: 1.1 }, { x: 1112, y: 472, s: 0.7 }, { x: 1340, y: 470, s: 1.3 },
  { x: 1358, y: 472, s: 0.8 }, { x: 1203, y: 580, s: 1.2 }, { x: 1257, y: 580, s: 1.1 },
  { x: 1230, y: 582, s: 0.8 }, { x: 1052, y: 396, s: 0.9 },
];
const crenels = Array.from({ length: 18 }, (_, i) => 1062 + i * 20);
---
<div class="scene" aria-hidden="true">
  <div class="scene-sky"></div>
  <div class="scene-layers">
    <svg class="layer" data-depth="0.15" viewBox="0 0 1600 900" preserveAspectRatio="xMaxYMax slice">
      <g fill="#e9e2d2" opacity=".5">
        <circle cx="180" cy="90" r="1" /><circle cx="420" cy="140" r=".8" /><circle cx="610" cy="60" r="1.1" />
        <circle cx="820" cy="120" r=".7" /><circle cx="960" cy="70" r="1" /><circle cx="1340" cy="110" r=".9" />
        <circle cx="1500" cy="60" r=".8" /><circle cx="300" cy="230" r=".7" /><circle cx="760" cy="210" r=".8" />
      </g>
      <path d="M0 610 L140 540 L260 585 L410 500 L560 570 L700 520 L860 590 L1000 530 L1140 575 L1290 505 L1440 560 L1600 520 V900 H0Z" fill="#14151d" />
    </svg>

    <svg class="layer" data-depth="0.35" viewBox="0 0 1600 900" preserveAspectRatio="xMaxYMax slice">
      <defs>
        <radialGradient id="fire" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#ffd27a" stop-opacity=".95" />
          <stop offset=".35" stop-color="#e2733a" stop-opacity=".55" />
          <stop offset="1" stop-color="#c23a45" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="smoke" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#3a2e33" stop-opacity=".55" />
          <stop offset="1" stop-color="#3a2e33" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="banner" x1="0" y1="1" x2="0" y2="0">
          <stop offset="0" stop-color="#ef6a5a" />
          <stop offset="1" stop-color="#a8283a" />
        </linearGradient>
        <linearGradient id="gate" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffcf7a" />
          <stop offset="1" stop-color="#c2492f" />
        </linearGradient>
      </defs>
      <ellipse class="smoke s1" cx="1110" cy="300" rx="110" ry="160" fill="url(#smoke)" />
      <ellipse class="smoke s2" cx="1350" cy="280" rx="100" ry="150" fill="url(#smoke)" />
      <path d="M880 720 Q1080 580 1250 575 Q1430 572 1600 660 V900 H880Z" fill="#101118" />
      <g fill="#0b0c11">
        <rect x="1060" y="470" width="360" height="110" />
        {crenels.map((x) => <rect x={x} y="456" width="11" height="16" />)}
        <rect x="1036" y="392" width="54" height="188" />
        <polygon points="1030,394 1063,318 1096,394" />
        <rect x="1386" y="404" width="54" height="176" />
        <polygon points="1380,406 1413,334 1446,406" />
        <rect x="1176" y="322" width="108" height="258" />
        <polygon points="1166,324 1230,214 1294,324" />
        <rect x="1300" y="372" width="38" height="208" />
        <polygon points="1294,374 1319,312 1344,374" />
        <rect x="1118" y="410" width="34" height="170" />
        <polygon points="1112,412 1135,356 1158,412" />
      </g>
      <path d="M1212 580 V538 a18 18 0 0 1 36 0 V580Z" fill="url(#gate)" opacity=".9" />
      <g fill="#e6a85a" class="windows">
        <rect x="1222" y="360" width="6" height="12" rx="3" /><rect x="1236" y="360" width="6" height="12" rx="3" />
        <rect x="1059" y="430" width="6" height="11" rx="3" /><rect x="1408" y="440" width="6" height="11" rx="3" />
        <rect x="1316" y="410" width="5" height="10" rx="2.5" /><rect x="1229" y="430" width="6" height="12" rx="3" />
        <rect x="1131" y="440" width="5" height="10" rx="2.5" />
      </g>
      <g class="banner-glow" fill="url(#fire)">
        <circle cx="1246" cy="196" r="34" opacity=".35" />
        <circle cx="1076" cy="304" r="24" opacity=".3" />
        <circle cx="1426" cy="320" r="24" opacity=".3" />
      </g>
      <g class="banners">
        <line x1="1230" y1="214" x2="1230" y2="170" stroke="#0b0c11" stroke-width="3" />
        <path class="flag f1" d="M1231 172 h34 l-8 9 l8 9 h-34z" fill="url(#banner)" />
        <line x1="1063" y1="318" x2="1063" y2="282" stroke="#0b0c11" stroke-width="2.5" />
        <path class="flag f2" d="M1064 284 h24 l-6 7 l6 7 h-24z" fill="url(#banner)" />
        <line x1="1413" y1="334" x2="1413" y2="298" stroke="#0b0c11" stroke-width="2.5" />
        <path class="flag f3" d="M1414 300 h24 l-6 7 l6 7 h-24z" fill="url(#banner)" />
      </g>
      <g class="fires">
        <circle class="fire" cx="1100" cy="462" r="34" fill="url(#fire)" />
        <circle class="fire" cx="1345" cy="458" r="40" fill="url(#fire)" style="animation-delay:-.6s" />
        <circle class="fire" cx="1230" cy="560" r="56" fill="url(#fire)" style="animation-delay:-1.1s" />
        <circle class="fire" cx="1420" cy="560" r="30" fill="url(#fire)" style="animation-delay:-.3s" />
        <circle class="fire" cx="1063" cy="392" r="38" fill="url(#fire)" style="animation-delay:-1.6s" />
      </g>
      <g class="flames">
        {flames.map((f, i) => (
          <path
            class="flame"
            style={`animation-delay:-${(i * 0.23).toFixed(2)}s`}
            transform={`translate(${f.x} ${f.y}) scale(${(f.s * (i % 2 ? -1 : 1)).toFixed(2)} ${f.s}) rotate(${(i % 3) * 4 - 4})`}
            d={flameShapes[i % flameShapes.length]}
            fill={i % 3 === 1 ? "#e2733a" : "#f59a4a"}
            opacity={0.65 + (i % 4) * 0.1}
          />
        ))}
      </g>
      <g class="shots" fill="none" stroke-linecap="round">
        <path d="M640 760 Q860 420 1090 452" stroke="url(#fire)" stroke-width="2" opacity=".55" />
        <circle cx="1090" cy="452" r="4" fill="#ffd791" stroke="none" />
        <path d="M820 700 Q1060 360 1330 446" stroke="url(#fire)" stroke-width="1.6" opacity=".4" />
      </g>
    </svg>

    <svg class="layer" data-depth="0.6" viewBox="0 0 1600 900" preserveAspectRatio="xMaxYMax slice">
      <path d="M0 760 Q260 700 520 742 Q760 780 980 700 Q1180 630 1330 690 Q1470 745 1600 720 V900 H0Z" fill="#0d0e13" />
      <g class="torches">
        {torches.map((t) => (
          <g style={`animation-delay:-${t.d}s;opacity:${t.o}`} class="torch">
            <circle cx={t.x} cy={t.y} r={t.r} fill="url(#fire)" />
            <circle cx={t.x} cy={t.y} r={t.c} fill="#ffd791" />
          </g>
        ))}
      </g>
    </svg>
  </div>
  <canvas class="scene-embers" data-embers></canvas>
  <div class="scene-shade"></div>
  <svg class="scene-ground" viewBox="0 0 1600 120" preserveAspectRatio="none">
    <defs>
      <linearGradient id="rim" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#e2733a" stop-opacity=".12" />
        <stop offset=".55" stop-color="#e2733a" stop-opacity=".3" />
        <stop offset="1" stop-color="#ffcf7a" stop-opacity=".6" />
      </linearGradient>
    </defs>
    <path d="M0 52 Q240 22 520 38 Q820 56 1080 30 Q1340 6 1600 36 V120 H0Z" fill="var(--bg)" />
    <path d="M0 52 Q240 22 520 38 Q820 56 1080 30 Q1340 6 1600 36" fill="none" stroke="url(#rim)" stroke-width="2" vector-effect="non-scaling-stroke" />
  </svg>
</div>

<script>
  import "../scripts/scene.ts";
</script>

<style>
  .scene { position: absolute; inset: 0; overflow: hidden; z-index: 0; }
  .scene-sky {
    position: absolute; inset: 0;
    background:
      radial-gradient(60% 45% at 78% 66%, rgba(194, 58, 69, 0.32), rgba(194, 58, 69, 0) 70%),
      radial-gradient(35% 30% at 77% 70%, rgba(226, 140, 70, 0.22), rgba(226, 140, 70, 0) 70%),
      linear-gradient(180deg, #07080c 0%, #0f0f16 45%, #1b1216 78%, #0b0c0f 100%);
  }
  .scene-layers {
    position: absolute; top: 0; bottom: 0; right: 0;
    width: max(100%, calc(100svh * 1.6));
  }
  .layer {
    position: absolute; inset: -2% -1% 0 -1%;
    width: 102%; height: 102%;
    max-width: none;
    will-change: transform;
  }
  .scene-ground {
    position: absolute; left: 0; right: 0; bottom: 0;
    width: 100%; height: 4.5rem;
    max-width: none;
  }
  .scene-embers { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .scene-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(11, 12, 15, 0.94) 0%, rgba(11, 12, 15, 0.72) 34%, rgba(11, 12, 15, 0.15) 64%, rgba(11, 12, 15, 0) 80%),
      linear-gradient(180deg, rgba(11, 12, 15, 0.55) 0%, rgba(11, 12, 15, 0) 22%, rgba(11, 12, 15, 0) 76%, rgba(11, 12, 15, 0.6) 100%);
  }
  /* Portrait: the castle takes the top band, the title sits clear below it. */
  @media (max-width: 760px), (max-aspect-ratio: 1/1) {
    .scene-sky {
      background:
        radial-gradient(70% 30% at 70% 30%, rgba(194, 58, 69, 0.34), rgba(194, 58, 69, 0) 70%),
        radial-gradient(40% 18% at 70% 34%, rgba(226, 140, 70, 0.24), rgba(226, 140, 70, 0) 70%),
        linear-gradient(180deg, #07080c 0%, #120f15 30%, #0b0c0f 62%);
    }
    .scene-layers {
      bottom: auto; height: 52%;
      width: max(100%, calc(52svh * 1.6));
      -webkit-mask-image: linear-gradient(180deg, #000 78%, transparent);
      mask-image: linear-gradient(180deg, #000 78%, transparent);
    }
    .scene-shade {
      background: linear-gradient(180deg, rgba(11, 12, 15, 0.5) 0%, rgba(11, 12, 15, 0) 16%, rgba(11, 12, 15, 0) 34%, rgba(11, 12, 15, 0.7) 52%, rgba(11, 12, 15, 0.86) 100%);
    }
  }

  .fire { transform-box: fill-box; transform-origin: center; animation: flicker 2.4s ease-in-out infinite; }
  .torch circle:first-child { animation: torch 1.6s ease-in-out infinite; animation-delay: inherit; }
  .flame { transform-box: fill-box; transform-origin: center bottom; animation: lick 1.1s ease-in-out infinite; }
  .flag { transform-box: fill-box; transform-origin: left center; animation: wave 3.2s ease-in-out infinite; }
  .f2 { animation-delay: -1s; } .f3 { animation-delay: -2s; }
  .smoke { transform-box: fill-box; transform-origin: center bottom; animation: smoke 14s ease-in-out infinite; }
  .s2 { animation-delay: -7s; }

  @keyframes flicker { 0%, 100% { opacity: 0.85; transform: scale(1); } 40% { opacity: 1; transform: scale(1.08); } 70% { opacity: 0.7; transform: scale(0.95); } }
  @keyframes torch { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
  @keyframes lick { 0%, 100% { transform: scale(1, 1); opacity: 0.9; } 50% { transform: scale(0.9, 1.15); opacity: 1; } }
  @keyframes wave { 0%, 100% { transform: skewY(0deg) scaleX(1); } 50% { transform: skewY(-4deg) scaleX(0.94); } }
  @keyframes smoke { 0%, 100% { transform: translateY(0) scale(1); opacity: 0.4; } 50% { transform: translateY(-30px) scale(1.12); opacity: 0.25; } }

  @media (prefers-reduced-motion: reduce) {
    .fire, .torch circle, .flag, .smoke, .flame { animation: none; }
  }
</style>
