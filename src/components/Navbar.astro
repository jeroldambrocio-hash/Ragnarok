---
import Icon from "./Icon.astro";
import { config } from "../config";
const links = [
  { href: "#servidor", label: "Servidor" },
  { href: "#woe", label: "WoE" },
  { href: "#rankings", label: "Rankings" },
  { href: "#descargar", label: "Descargar" },
];
const discordHref = config.discordUrl || "#comunidad";
const discordExternal = Boolean(config.discordUrl);
---
<header class="nav" data-nav>
  <nav class="nav-inner wrap" aria-label="Principal">
    <a class="brand" href="#inicio" aria-label="Ragnarok Forever, inicio">
      <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"><path d="M16 4l8 12-8 12-8-12z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M16 10.5l3.6 5.5-3.6 5.5-3.6-5.5z" fill="currentColor"/></svg>
      <span>Ragnarok <em>Forever</em></span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
      <span class="sr-only">Abrir menú</span>
      <Icon name="menu" size={22} class="i-open" />
      <Icon name="close" size={22} class="i-close" />
    </button>

    <div class="nav-menu" id="nav-menu" data-nav-menu>
      <ul class="nav-links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <div class="nav-actions">
        <a class="nav-discord" href={discordHref} {...(discordExternal ? { target: "_blank", rel: "noopener" } : {})}>
          <Icon name="chat" size={18} /><span>Discord</span>
        </a>
        <a class="btn btn--primary nav-play" href="#registro">Jugar</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]")!;
  const toggle = nav.querySelector<HTMLButtonElement>("[data-nav-toggle]")!;
  const menu = nav.querySelector<HTMLElement>("[data-nav-menu]")!;
  const label = toggle.querySelector(".sr-only")!;

  const setOpen = (open: boolean) => {
    nav.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    label.textContent = open ? "Cerrar menú" : "Abrir menú";
  };
  toggle.addEventListener("click", () => setOpen(!nav.classList.contains("is-open")));
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && nav.classList.contains("is-open")) {
      setOpen(false);
      toggle.focus();
    }
  });

  const onScroll = () => nav.classList.toggle("is-scrolled", scrollY > 24);
  onScroll();
  addEventListener("scroll", onScroll, { passive: true });

  // Highlight the section in view.
  const anchors = new Map(
    Array.from(nav.querySelectorAll<HTMLAnchorElement>(".nav-links a")).map((a) => [a.hash.slice(1), a]),
  );
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const a = anchors.get(e.target.id);
        if (a && e.isIntersecting) {
          anchors.forEach((x) => x.removeAttribute("aria-current"));
          a.setAttribute("aria-current", "true");
        }
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  anchors.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) io.observe(el);
  });
</script>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    height: var(--nav-h);
    transition: background-color 200ms, border-color 200ms, backdrop-filter 200ms;
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled, .nav.is-open {
    background: rgba(11, 12, 15, 0.78);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: var(--line);
  }
  .nav-inner { height: 100%; display: flex; align-items: center; gap: 2rem; }

  .brand {
    display: inline-flex; align-items: center; gap: 0.6rem;
    color: var(--gold);
    text-decoration: none;
  }
  .brand span { font: 400 1.125rem/1 var(--display); letter-spacing: 0.04em; color: var(--text); white-space: nowrap; }
  .brand em { font-style: normal; color: var(--gold); }

  .nav-menu { display: flex; align-items: center; gap: 2rem; margin-left: auto; }
  .nav-links { display: flex; gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
  .nav-links a {
    position: relative;
    display: block;
    padding: 0.5rem 0.8rem;
    font: 500 0.875rem/1 var(--sans);
    letter-spacing: 0.04em;
    color: var(--text-2);
    text-decoration: none;
    border-radius: 6px;
    transition: color var(--fast);
  }
  .nav-links a::after {
    content: ""; position: absolute; left: 0.8rem; right: 0.8rem; bottom: 0.15rem;
    height: 1px; background: var(--gold);
    transform: scaleX(0); transform-origin: left; transition: transform 220ms var(--ease-out);
  }
  .nav-links a:hover, .nav-links a[aria-current] { color: var(--text); }
  .nav-links a:hover::after, .nav-links a[aria-current]::after { transform: scaleX(1); }

  .nav-actions { display: flex; align-items: center; gap: 0.75rem; }
  .nav-discord {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.5rem 0.6rem;
    font: 500 0.875rem/1 var(--sans);
    color: var(--text-2); text-decoration: none; border-radius: 6px;
    transition: color var(--fast);
  }
  .nav-discord:hover { color: var(--text); }
  .nav-play { min-height: 2.4rem; padding: 0.5rem 1.1rem; font-size: 0.875rem; }

  .nav-toggle {
    display: none;
    margin-left: auto;
    width: 2.75rem; height: 2.75rem;
    align-items: center; justify-content: center;
    color: var(--text); background: none; border: 0; border-radius: 8px; cursor: pointer;
  }
  .nav-toggle :global(.i-close) { display: none; }
  .nav.is-open .nav-toggle :global(.i-open) { display: none; }
  .nav.is-open .nav-toggle :global(.i-close) { display: block; }

  @media (max-width: 860px) {
    .nav-toggle { display: inline-flex; }
    .nav-menu {
      position: absolute; top: var(--nav-h); left: 0; right: 0;
      flex-direction: column; align-items: stretch; gap: 1rem;
      padding: 0.75rem var(--gutter) 1.5rem;
      background: rgba(11, 12, 15, 0.96);
      border-bottom: 1px solid var(--line);
      opacity: 0; visibility: hidden; transform: translateY(-8px);
      transition: opacity 180ms, transform 220ms var(--ease-out), visibility 0s 220ms;
    }
    .nav.is-open .nav-menu { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
    .nav-links { flex-direction: column; }
    .nav-links a { padding: 0.9rem 0; font-size: 1.0625rem; border-bottom: 1px solid var(--line); border-radius: 0; }
    .nav-links a::after { display: none; }
    .nav-actions { justify-content: space-between; }
    .nav-play { min-height: 2.75rem; padding-inline: 1.6rem; }
  }
</style>
