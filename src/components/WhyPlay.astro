---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
const reasons = [
  { icon: "scale", title: "Juego equilibrado", text: "Clases y builds viables. Ninguna dominará el servidor." },
  { icon: "coin", title: "Sin pay-to-win", text: "Lo que se gana jugando no se compra con dinero." },
  { icon: "castle", title: "War of Emperium", text: "Guerras de guilds semanales por los castillos de Rune-Midgard." },
  { icon: "sword", title: "Experiencia clásica", text: "Pre-renewal de verdad: mapas, fórmulas y ritmo de siempre." },
  { icon: "shield", title: "Anti-cheat", text: "Protección contra bots y programas externos." },
  { icon: "refresh", title: "Actualizaciones frecuentes", text: "Correcciones y eventos de forma regular." },
];
---
<Section id="por-que" title="Por qué Ragnarok Forever" class="why">
  <ul class="reasons">
    {reasons.map((r) => (
      <li class="reason">
        <span class="reason-icon"><Icon name={r.icon} size={22} /></span>
        <h3>{r.title}</h3>
        <p>{r.text}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .reasons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0; padding: 0; list-style: none;
    border-top: 1px solid var(--line);
  }
  .reason {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 1rem;
    padding: 1.75rem 1.5rem 1.75rem 0;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--fast);
  }
  .reason-icon {
    grid-row: span 2;
    display: grid; place-items: center;
    width: 2.75rem; height: 2.75rem;
    color: var(--gold);
    border: 1px solid var(--line);
    border-radius: 50%;
    transition: border-color var(--fast), transform 220ms var(--ease-out);
  }
  .reason:hover .reason-icon { border-color: rgba(212, 176, 106, 0.5); transform: scale(1.06); }
  .reason h3 { font: 600 1.0625rem/1.3 var(--sans); align-self: end; }
  .reason p { color: var(--text-2); font-size: 0.9375rem; margin-top: 0.25rem; }

  @media (max-width: 900px) { .reasons { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .reasons { grid-template-columns: 1fr; } .reason { padding-right: 0; } }
</style>
