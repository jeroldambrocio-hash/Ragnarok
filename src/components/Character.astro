---
/**
 * Character: a pixel-art Ragnarok class that doubles as a navigation link.
 *
 * The sprite sheets in /public/sprites are original pixel art generated by
 * tools/sprites.py (44x72 frames). Columns: idle, idle (breath), wave, cheer.
 * Rows: head front, looking left, looking right. To use other sprites, drop in
 * a sheet with the same grid and pass its file name as `sprite`.
 */
import Icon from "./Icon.astro";
interface Props {
  href: string;
  label: string;
  icon: string;
  sprite: string;
  job: string;
  delay?: number;
}
const { href, label, icon, sprite, job, delay = 0 } = Astro.props;
const sheet = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/sprites/${sprite}.png`;
---
<a class="guide" href={href} data-guide style={`--sheet:url(${sheet});--d:${delay}s`}>
  <span class="guide-label"><Icon name={icon} size={16} />{label}</span>
  <span class="guide-fig" aria-hidden="true">
    <span class="guide-sprite" title={job}></span>
  </span>
</a>

<style is:global>
  .guide {
    --s: 2; --row: 0;
    position: relative;
    display: inline-flex; flex-direction: column; align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.5rem 0;
    color: var(--text);
    text-decoration: none;
    border-radius: 12px;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .guide-fig { position: relative; display: block; }
  .guide-fig::after {
    content: ""; position: absolute; left: 50%; bottom: calc(1px * var(--s));
    width: calc(24px * var(--s)); height: calc(5px * var(--s));
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.6), transparent);
    z-index: -1;
  }
  .guide-sprite {
    display: block;
    width: calc(44px * var(--s)); height: calc(72px * var(--s));
    background-image: var(--sheet);
    background-repeat: no-repeat;
    background-size: calc(176px * var(--s)) calc(216px * var(--s));
    background-position: 0 calc(var(--row) * -72px * var(--s));
    image-rendering: pixelated;
    animation: guide-idle 1.6s steps(1, end) var(--d) infinite;
    transition: filter 220ms;
  }

  .guide-label {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    font: 600 0.8125rem/1 var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text);
    background: rgba(16, 18, 23, 0.82);
    border: 1px solid var(--line);
    border-radius: 999px;
    opacity: 0.72;
    transform: translateY(3px);
    transition: opacity var(--fast), transform 220ms var(--ease-out), border-color var(--fast);
    pointer-events: none;
  }
  .guide-label svg { color: var(--gold); }

  @media (hover: hover) {
    .guide:hover .guide-fig { animation: guide-hop 480ms var(--ease-out); }
    .guide:hover .guide-sprite {
      animation: none;
      background-position-x: calc(-88px * var(--s));
      filter: drop-shadow(0 0 10px rgba(212, 176, 106, 0.35));
    }
    .guide:hover .guide-label { opacity: 1; transform: none; border-color: rgba(212, 176, 106, 0.45); }
  }
  .guide:focus-visible .guide-label { opacity: 1; transform: none; border-color: var(--gold); }
  .guide:focus-visible .guide-sprite { animation: none; background-position-x: calc(-88px * var(--s)); }
  .guide:focus-visible { outline-offset: 2px; }

  .guide.is-go .guide-fig { animation: guide-go 420ms var(--ease-out) forwards; }
  .guide.is-go .guide-sprite { animation: none; background-position-x: calc(-132px * var(--s)); }

  @keyframes guide-idle {
    0% { background-position-x: 0; }
    50% { background-position-x: calc(-44px * var(--s)); }
  }
  @keyframes guide-hop {
    0%, 100% { transform: translateY(0); }
    45% { transform: translateY(-10px); }
  }
  @keyframes guide-go {
    0% { transform: translateY(0); }
    30% { transform: translateY(2px); }
    65% { transform: translateY(-22px); }
    100% { transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-sprite { animation: none; }
    .guide:hover .guide-fig, .guide.is-go .guide-fig { animation: none; }
  }
</style>
