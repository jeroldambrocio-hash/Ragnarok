---
import WoeScene from "./WoeScene.astro";
import Character from "./Character.astro";
import Button from "./Button.astro";
import { config } from "../config";

// Each section has a classic first job as its guide.
const left = [
  { href: "#servidor", label: "Servidor", icon: "server", sprite: "novice", job: "Novice", delay: 0 },
  { href: "#woe", label: "WoE", icon: "castle", sprite: "swordman", job: "Swordman", delay: -0.5 },
];
const right = [
  { href: "#rankings", label: "Rankings", icon: "trophy", sprite: "mage", job: "Mage", delay: -1.1 },
  { href: "#descargar", label: "Descargar", icon: "download", sprite: "merchant", job: "Merchant", delay: -0.8 },
];
const discordHref = config.discordUrl || "#comunidad";
---
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <WoeScene />
  <div class="hero-inner wrap">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title"><span>Ragnarok</span><span>Forever</span></h1>
      <p class="hero-tag">El Ragnarok clásico. Para siempre.</p>
      <p class="hero-meta"><span>Pre-renewal</span><span aria-hidden="true">·</span><span>Rates 5x</span><span aria-hidden="true">·</span><span>War of Emperium</span></p>
      <div class="hero-actions">
        <Button href="#registro" variant="primary" size="lg" icon="play">Jugar ahora</Button>
        <Button href="#descargar" variant="secondary" size="lg" icon="download">Descargar</Button>
        <Button href={discordHref} variant="ghost" size="lg" icon="chat" external={Boolean(config.discordUrl)}>Discord</Button>
      </div>
    </div>
  </div>
  <nav class="hero-novices" aria-label="Explorar con los personajes">
    <div class="band band--left">
      {left.map((n) => <Character {...n} />)}
    </div>
    <div class="band band--right">
      {right.map((n) => <Character {...n} />)}
    </div>
  </nav>
</section>

<script>
  import "../scripts/guides.ts";
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: clamp(38rem, 100svh, 60rem);
    display: grid;
    grid-template-rows: 1fr auto;
    isolation: isolate;
    overflow: hidden;
  }
  .hero-inner {
    position: relative; z-index: 1;
    display: flex; align-items: center;
    padding-top: calc(var(--nav-h) + clamp(2rem, 6vh, 4rem));
    padding-bottom: 0;
  }
  .hero-copy { max-width: 40rem; }

  .hero-title {
    display: flex; flex-direction: column;
    font: 400 clamp(3.4rem, 9vw, 6rem)/0.92 var(--display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .hero-title span:last-child { color: var(--gold); padding-left: 0.08em; }

  .hero-tag {
    margin-top: 1.5rem;
    font-size: clamp(1.15rem, 2vw, 1.375rem);
    color: var(--text);
  }
  .hero-meta {
    display: flex; flex-wrap: wrap; gap: 0.6rem;
    margin-top: 0.6rem;
    font: 500 0.8125rem/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 2.25rem; }

  .hero-novices {
    position: relative; z-index: 2;
    display: flex; justify-content: center; align-items: flex-end;
    gap: clamp(2rem, 9vw, 10rem);
    width: 100%;
    max-width: calc(var(--max) + var(--gutter) * 2);
    margin-inline: auto;
    padding: 0 var(--gutter) clamp(0.75rem, 3vh, 2rem);
  }
  .band { display: flex; gap: clamp(0.5rem, 2vw, 1.75rem); align-items: flex-end; }

  @media (min-width: 1100px) {
    .hero-novices :global(.guide) { --s: 2; }
  }
  /* Portrait: castle in the top band (see WoeScene), copy below it. */
  @media (max-width: 760px), (max-aspect-ratio: 1/1) {
    .hero-inner { align-items: flex-end; padding-top: 44svh; padding-bottom: 2.5rem; }
  }
  @media (max-width: 760px) {
    .hero-inner { padding-top: 44svh; padding-bottom: 0.5rem; }
    .hero-actions { gap: 0.6rem; }
    .hero-actions :global(.btn--primary) { flex: 1 1 100%; }
    .hero-actions :global(.btn--secondary) { flex: 1 1 auto; }
    .hero-novices {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 0.25rem;
      padding-top: 1.5rem;
    }
    .band { display: contents; }
    .hero-novices :global(.guide) { padding-inline: 0; --s: 1.5; }
    .hero-novices :global(.guide-label) {
      opacity: 1; transform: none; order: 2;
      padding: 0.3rem 0.5rem; font-size: 0.6875rem; letter-spacing: 0.04em;
      background: none; border-color: transparent;
    }
    .hero-novices :global(.guide-label svg) { display: none; }
  }
</style>
